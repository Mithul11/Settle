# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (include ?sslmode=require)
DATABASE_URL=

# PayPal SANDBOX REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Google AI Studio key for Gemini (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub token, raises the API rate limit when reading repos
GITHUB_TOKEN=
